{
  "name": "dsh-session-deleter",
  "version": "0.3.1",
  "description": "DeepSeek Harness 会话彻底删除插件：在会话右键菜单提供「删除会话」，永久清除物理日志、投影缓存行与工作区注册表引用（内置只有归档，无删除）。",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "dsh-plugin",
    "session",
    "delete"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0-0"
  }
}
